@Awsome_Invontory_App_Backend_HostAddress = http://localhost:5174


POST {{Awsome_Invontory_App_Backend_HostAddress}}/users/authenticate/
Content-Type: application/json

{
    "email": "test@example.com",
    "password": "test"
}

> {%
    client.global.set("token", response.body.token);
    client.log("JWT stored: " + response.body.token);
%}

###

GET {{Awsome_Invontory_App_Backend_HostAddress}}/Users
Authorization: Bearer {{token}}

###
POST {{Awsome_Invontory_App_Backend_HostAddress}}/Users/register
Content-Type: application/json

{
    "email": "test@example.com",
    "Username": "test",
    "Password": "test",
    "PasswordConfirmation": "test"
}

> {% 
    client.global.set("auth_token", response.body.token);
 %}
###

GET {{Awsome_Invontory_App_Backend_HostAddress}}/Items
Content-Type: application/json
Authorization: Bearer {{auth_token}}

