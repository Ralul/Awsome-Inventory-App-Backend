<?xml version="1.0" encoding="utf-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ============================================================ -->
    <!-- 1. Create tables                                             -->
    <!-- ============================================================ -->
    <changeSet id="20f6d3ea-e822-4e10-a2c1-bbd7c3f90051" author="user">
        <createTable tableName="users">
            <column name="id" type="uuid">
                <constraints primaryKey="true"/>
            </column>
            <column name="email" type="varchar"/>
            <column name="username" type="varchar"/>
            <column name="hashed_password" type="varchar"/>
            <column name="salt" type="varchar"/>
        </createTable>
        
        <createTable tableName="items">
            <column name="id" type="uuid">
                <constraints primaryKey="true" />
            </column>
            <column name="name" type="varchar" />
            <column name="description" type="varchar" />
            <column name="bar_code" type="varchar" />
        </createTable>
    </changeSet>

    <!-- ============================================================ -->
    <!-- 2. Foreign keys                                              -->
    <!-- ============================================================ -->
    <changeSet id="3c9bbbc3-8ece-4588-a39e-9307dca1bc91" author="user">

    </changeSet>
</databaseChangeLog>